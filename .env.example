# Copy to .env and change every value marked CHANGE
DJANGO_SECRET_KEY=CHANGE-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,pjo.example.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://pjo.example.local
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

POSTGRES_DB=cps_pjo
POSTGRES_USER=cps_pjo
POSTGRES_PASSWORD=CHANGE-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Attachments and signatures (never served publicly)
PRIVATE_MEDIA_ROOT=/data/private_media
MAX_ATTACHMENT_MB=15

# Server-side PDF (headless Chromium via Playwright). Leave empty to use the bundled browser.
CHROMIUM_EXECUTABLE=

WEB_PORT=8000
LOG_LEVEL=INFO
